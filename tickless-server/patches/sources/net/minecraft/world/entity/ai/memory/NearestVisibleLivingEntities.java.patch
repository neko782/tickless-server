+    /** Build once per sensor snapshot, then skip entity types a sensor cannot use. */
+    private TypeIndex typeIndices() {
+        TypeIndex indices = this.typeIndices;
+        if (indices == null) {
+            EntityType<?> uniform = this.nearbyEntities.isEmpty() ? null : this.nearbyEntities.getFirst().getType();
+            for (int i = 1; uniform != null && i < this.nearbyEntities.size(); i++) {
+                if (this.nearbyEntities.get(i).getType() != uniform) uniform = null;
+            }
+            if (uniform != null) {
+                this.typeIndices = indices = new TypeIndex(uniform, Map.of());
+                return indices;
+            }
+            Map<EntityType<?>, IntArrayList> builders = new java.util.IdentityHashMap<>();
+            for (int i = 0; i < this.nearbyEntities.size(); i++) {
+                builders.computeIfAbsent(this.nearbyEntities.get(i).getType(), ignored -> new IntArrayList()).add(i);
+            }
+            Map<EntityType<?>, int[]> built = new java.util.IdentityHashMap<>();
+            builders.forEach((type, positions) -> built.put(type, positions.toIntArray()));
+            this.typeIndices = indices = new TypeIndex(null, java.util.Collections.unmodifiableMap(built));
+        }
+        return indices;
+    }
