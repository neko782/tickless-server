+    /** Takes the read lock for {@code pos} if the current event needs one, and returns its chunk. */
+    private LevelChunk chunkForRead(final BlockPos pos) {
+        int chunkX = SectionPos.blockToSectionCoord(pos.getX());
+        int chunkZ = SectionPos.blockToSectionCoord(pos.getZ());
+        WorldTxn txn = WorldTxn.current();
+        if (txn == null) {
+            return this.getChunk(chunkX, chunkZ);
+        }
+
+        if (txn.shouldLockRead(pos)) {
+            txn.lock(this.worldLocks.forBlock(pos.asLong()));
+        }
+
+        long key = ChunkPos.pack(chunkX, chunkZ);
+        if (txn.cachedChunk(this, key) instanceof LevelChunk cached) {
+            return cached;
+        }
+
+        LevelChunk chunk = this.getChunk(chunkX, chunkZ);
+        txn.cacheChunk(this, key, chunk);
+        return chunk;
+    }
