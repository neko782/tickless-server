+    public static boolean runsCommandOnServerThread(final String command) {
+        int end = command.indexOf(' ');
+        String root = end < 0 ? command : command.substring(0, end);
+        if (root.startsWith("/")) {
+            root = root.substring(1);
+        }
+
+        int namespace = root.indexOf(':');
+        return SERVER_THREAD_COMMANDS.contains(namespace < 0 ? root : root.substring(namespace + 1));
