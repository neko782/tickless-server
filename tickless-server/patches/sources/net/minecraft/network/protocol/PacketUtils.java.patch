     public static <T extends PacketListener> void ensureRunningOnSameThread(final Packet<T> packet, final T listener, final ServerLevel level) throws RunningOnDifferentThreadException {
+        // A player's world packets run on the player's lane, never on the server thread.
+        if (listener instanceof ServerGamePacketListenerImpl game) {
+            PlayerLane lane = game.lane();
+            if (lane.isRunningHere()) {
+                return;
+            }
+
+            if (lane.isActive()) {
+                lane.submitPacket(listener, packet, ServerGamePacketListenerImpl.runsOnServerThread(packet));
+                throw RunningOnDifferentThreadException.RUNNING_ON_DIFFERENT_THREAD;
+            }
+        }
+
         ensureRunningOnSameThread(packet, listener, level.getServer().packetProcessor());
     }
 
